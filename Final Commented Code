// ---------- Buttons (tap and hold) ----------
enum BtnEvent : uint8_t { EV_NONE, EV_TAP, EV_HOLD };

struct Button {
  uint8_t  pin;
  bool     stable;
  bool     lastRead;
  uint32_t changedAt;
  uint32_t pressedAt;
  bool     holdFired;
};
Button btnPrev    = { PIN_BTN_PREV,    HIGH, HIGH, 0, 0, false };
Button btnRefresh = { PIN_BTN_REFRESH, HIGH, HIGH, 0, 0, false };
Button btnNext    = { PIN_BTN_NEXT,    HIGH, HIGH, 0, 0, false };

// Reads one button with debouncing. Returns EV_TAP when it is released after a
// short press, EV_HOLD once it has been held for LONG_PRESS_MS, otherwise EV_NONE.
// Edge cases:
//   * Contact bounce: a new level only counts after it has been steady for
//     DEBOUNCE_MS, so one press can't register as several taps.
//   * A hold must not also fire a tap: holdFired is set when the hold triggers,
//     and the release afterwards is ignored.
//   * millis() wrap: only differences (now - time) are compared, and unsigned
//     subtraction gives the right answer even after the counter rolls over.
BtnEvent pollButton(Button& b, uint32_t now) {
  bool r = digitalRead(b.pin);
  if (r != b.lastRead) { b.lastRead = r; b.changedAt = now; }
  BtnEvent ev = EV_NONE;
  if (now - b.changedAt > DEBOUNCE_MS && r != b.stable) {
    b.stable = r;
    if (r == LOW) { b.pressedAt = now; b.holdFired = false; }   // pull-up: LOW = pressed
    else if (!b.holdFired) ev = EV_TAP;                         // released before a hold
  }
  if (b.stable == LOW && !b.holdFired && now - b.pressedAt >= LONG_PRESS_MS) {
    b.holdFired = true;
    ev = EV_HOLD;
  }
  return ev;
}

// ---------- Small helpers ----------
// Safe string copy: copies at most size-1 characters and always ends with 0.
// Edge cases: text longer than the buffer is cut off instead of overflowing,
// and the result always ends with 0 (strncpy doesn't guarantee that).
void copyStr(char* dst, const char* src, size_t size) {
  size_t i = 0;
  while (i + 1 < size && src[i]) { dst[i] = src[i]; i++; }
  dst[i] = 0;
}

// Shows a short message box in the middle of the screen for TOAST_MS.
void showToast(uint32_t now, const char* text) {
  copyStr(toastText, text, sizeof(toastText));
  toastUntil = now + TOAST_MS;
}

// Adds one row. Only rows inside the visible window are stored.
// Edge cases: vsnprintf never writes past LINE_CHARS, so a long value (a big
// number, a long name) is cut off rather than overflowing the row. Rows that
// are scrolled off screen are counted but not stored, so RAM use stays fixed
// no matter how many rows a page has.
void addLine(uint8_t style, const char* fmt, ...) {
  uint8_t idx = rowCursor++;
  if (idx < rowFrom || idx >= (uint8_t)(rowFrom + VISIBLE_LINES)) return;
  Row& r = vis[idx - rowFrom];
  va_list ap;
  va_start(ap, fmt);
  vsnprintf(r.text, LINE_CHARS + 1, fmt, ap);
  va_end(ap);
  r.style = style;
}
#define ADD(style, fmt, ...) addLine(style, fmt, ##__VA_ARGS__)

// Adds text as several rows, wrapping at spaces.
void addWrapped(const char* text, uint8_t indent, uint8_t style) {
  const size_t width = LINE_CHARS - indent;
  const size_t len = strlen(text);
  size_t pos = 0;
  while (pos < len) {
    size_t chunk = len - pos;
    if (chunk > width) {
      chunk = width;
      size_t k = chunk;
      while (k > 0 && text[pos + k] != ' ') k--;
      if (k > 0) chunk = k;                    // a single word longer than a row has no space: it is cut at the row width instead
    }
    char buf[LINE_CHARS + 1];
    uint8_t n = 0;
    while (n < indent) buf[n++] = ' ';
    for (size_t i = 0; i < chunk && n < LINE_CHARS; i++) buf[n++] = text[pos + i];
    buf[n] = 0;
    ADD(style, "%s", buf);
    pos += chunk;
    while (text[pos] == ' ') pos++;            // skip extra spaces so a row never starts with blanks
  }
}

// Percent of reps that were correct (0 when there are no reps yet).
// Edge case: nobody has done a rep yet (0 + 0) -> returns 0 instead of dividing
// by zero.
int percentCorrect(uint32_t c, uint32_t i) {
  return (c + i) ? (int)(c * 100UL / (c + i)) : 0;
}

// Adds up everyone on screen: active count, attention count, people whose
// last rep was wrong, and total right/wrong reps. Used by the Overview page.
Agg aggregate() {
  Agg a;
  memset(&a, 0, sizeof(a));
  a.n = totalActive;
  for (uint8_t i = 0; i < viewCount; i++) {
    if (view[i].needs) a.attn++;
    if (view[i].lastRep == 'I') a.wrong++;
    a.c += view[i].correct;
    a.w += view[i].incorrect;
  }
  return a;
}

// Compares two Overview totals and returns O_* bits for the values that changed.
uint8_t diffAgg(const Agg& a, const Agg& b) {
  uint8_t m = 0;
  if (a.n != b.n)         m |= O_ACTIVE;
  if (a.attn != b.attn)   m |= O_ATTN;
  if (a.wrong != b.wrong) m |= O_WRONG;
  if (a.c != b.c)         m |= O_CORR;
  if (a.w != b.w)         m |= O_WRNG;
  if (percentCorrect(a.c, a.w) != percentCorrect(b.c, b.w)) m |= O_AVG;
  return m;
}

// Compares two versions of one person and returns F_* bits for what changed.
uint8_t diffUser(const User& a, const User& b) {
  uint8_t m = 0;
  if (a.correct != b.correct)     m |= F_CORRECT | F_PCT | F_LAST;   // a new rep happened
  if (a.incorrect != b.incorrect) m |= F_WRONG | F_PCT | F_LAST;
  if (a.lastRep != b.lastRep)     m |= F_LAST;
  if (strcmp(a.issue, b.issue) != 0) m |= F_ISSUE;
  if (a.needs != b.needs || strcmp(a.reason, b.reason) != 0) m |= F_ATTN;
  return m;
}

// Works out a person's wrong-in-a-row count from the old and new rep totals.
// Edge cases:
//   * Totals went DOWN (the person started a new set, or the data was reset):
//     the old streak no longer means anything, so it restarts from the last rep.
//   * Several reps happened between two downloads: wrong reps are added up;
//     if any correct rep happened too, only the latest rep counts.
//   * The streak is capped at 255 so it can't overflow its 8-bit variable.
uint8_t nextStreak(const User& oldU, const User& newU) {
  if (newU.correct < oldU.correct || newU.incorrect < oldU.incorrect) {
    return (newU.lastRep == 'I') ? 1 : 0;      // totals went down: a new set started
  }
  uint16_t newRight = newU.correct - oldU.correct;
  uint16_t newWrong = newU.incorrect - oldU.incorrect;
  if (newRight > 0) return (newU.lastRep == 'I') ? 1 : 0;   // a correct rep breaks the streak
  uint16_t s = oldU.streak + newWrong;
  return (s > 255) ? 255 : (uint8_t)s;
}

// How many people's most recent rep was wrong.
uint8_t wrongNow() {
  uint8_t n = 0;
  for (uint8_t i = 0; i < viewCount; i++) if (view[i].lastRep == 'I') n++;
  return n;
}

// ---------- Page switching ----------
// Called when leaving a page: stops highlighting the rows that were shown as changed.
void leavePage() {
  if (page == 0) ovShown = 0;
  else if (page <= viewCount) view[page - 1].shown = 0;
}

// Highlight what changed since you were last on this page.
void enterPage() {
  if (page == 0) {
    ovShown = ovMask;
    ovMask = 0;
    ovUnseen = false;
  } else if (page <= viewCount) {
    User& u = view[page - 1];
    u.shown = u.mask;
    u.mask = 0;
    u.unseen = false;
  }
}

// Switches to another page (0 = Overview, 1.. = people).
void goToPage(uint8_t newPage) {
  leavePage();
  page = newPage;
  enterPage();
}

// Right button hold: jump to the next person who needs help (buzzer alarm or a
// wrong last rep).
// Edge cases: with nobody on screen (viewCount = 0) the loop never runs, so the
// % viewCount never divides by zero and the toast says NO ALERTS. The search
// starts after the current person and wraps around, so pressing it again moves
// on to the next person instead of staying on the same one.
void jumpToNextAlert(uint32_t now) {
  uint8_t start = (page == 0) ? 0 : page;      // 0-based index of the person after the current one
  for (uint8_t step = 0; step < viewCount; step++) {
    uint8_t idx = (start + step) % viewCount;
    if (view[idx].alarm || view[idx].lastRep == 'I') {
      goToPage(idx + 1);
      char t[14];
      char nm[9];
      copyStr(nm, view[idx].name, sizeof(nm));
      snprintf(t, sizeof(t), "> %s", nm);
      showToast(now, t);
      return;
    }
  }
  showToast(now, "NO ALERTS");
}

// ---------- Reading a download ----------
// Gets ready to read a new download: marks everyone as not-yet-seen and
// remembers who is on screen so we can stay on that person afterwards.
void beginParse() {
  for (uint8_t i = 0; i < viewCount; i++) view[i].seen = false;
  prevName[0] = 0;
  if (page > 0 && page <= viewCount) copyStr(prevName, view[page - 1].name, sizeof(prevName));
  oldAgg = aggregate();
  rxLen = 0;
  gotHeader = false;
  gotErr = false;
}

// Reads one line of downloaded data, either:
//   OK|<active count>
//   ERR|<reason>
//   name|exercise|right|wrong|percent|last_rep|needs|issue|reason
// and adds or updates that person in view[].
// Edge cases:
//   * Empty line -> ignored.
//   * Missing fields (a short line) -> the missing ones read as empty text / 0.
//   * Extra '|' -> can't happen for real data because cleanText() turns '|'
//     into '/'; anything past field 9 would just stay in the last field.
//   * Garbage in a number field -> atoi() gives 0, and constrain() keeps every
//     value inside its variable's range (percent stays 0..100).
//   * Screen already full (MAX_USERS) -> extra people are counted in the
//     Overview total but not stored, so memory is never exceeded.
void handleLine() {
  rx[rxLen] = 0;
  rxLen = 0;
  if (rx[0] == 0) return;                      // blank line: nothing to do

  if (strncmp(rx, "OK|", 3) == 0) {
    int n = atoi(rx + 3);
    totalActive = (uint8_t)constrain(n, 0, 99);
    gotHeader = true;
    return;
  }
  if (strncmp(rx, "ERR|", 4) == 0) {
    copyStr(netMsg, rx + 4, sizeof(netMsg));
    gotErr = true;
    return;
  }

  // name|exercise|right|wrong|percent|last_rep|needs|issue|reason
  char* f[9];
  uint8_t nf = 0;
  char* p = rx;
  f[nf++] = p;
  while (*p && nf < 9) {
    if (*p == '|') { *p = 0; f[nf++] = p + 1; }
    p++;
  }
  while (nf < 9) f[nf++] = p;                  // missing fields read as empty text

  User t;
  memset(&t, 0, sizeof(t));
  copyStr(t.name, f[0], sizeof(t.name));
  copyStr(t.ex, f[1], sizeof(t.ex));
  t.correct   = (uint16_t)constrain(atoi(f[2]), 0, 65535);
  t.incorrect = (uint16_t)constrain(atoi(f[3]), 0, 65535);
  t.pct       = (uint8_t)constrain(atoi(f[4]), 0, 100);
  t.lastRep   = (f[5][0] == 'I') ? 'I' : ((f[5][0] == 'C') ? 'C' : 0);
  t.needs     = (f[6][0] == '1');
  copyStr(t.issue, f[7], sizeof(t.issue));
  copyStr(t.reason, f[8], sizeof(t.reason));
  t.seen = true;

  int j = -1;
  for (uint8_t q = 0; q < viewCount; q++) {
    if (strcmp(view[q].name, t.name) == 0) { j = q; break; }
  }
  if (j >= 0) {
    uint8_t m = diffUser(view[j], t);
    t.mask = view[j].mask;
    t.shown = view[j].shown;
    t.unseen = view[j].unseen;
    bool isCurrent = (prevName[0] != 0 && strcmp(prevName, t.name) == 0);
    if (m && !isCurrent) {                     // changes on the page you're on just update quietly
      t.mask |= m;
      t.unseen = true;
    }
    t.streak = nextStreak(view[j], t);
    t.acked = view[j].acked;
    view[j] = t;
  } else if (viewCount < MAX_USERS) {          // new person
    t.mask = F_ALL;
    t.unseen = true;
    t.streak = (t.lastRep == 'I') ? 1 : 0;   // we only know about their latest rep
    view[viewCount++] = t;
  }
}

// Feeds one complete line (without newline) to the parser.
void feedLine(const char* line) {
  copyStr(rx, line, sizeof(rx));
  rxLen = strlen(rx);
  handleLine();
}

// Finishes a download: removes people who are no longer active, keeps the
// current page on the same person, and works out what changed for the highlights.
// If the download failed, the old data stays on screen and OFFLINE is shown.
void updateAlarms(uint32_t now);              // defined in the buzzer section below
// Edge cases:
//   * Failed download or no "OK" line: the previous data is kept rather than
//     wiping the screen, and OFFLINE is shown with a short reason.
//   * The person on screen is no longer active: the page number is clamped so
//     it never points past the end of the list.
//   * First download after start-up: nothing is highlighted as "new", because
//     there was nothing before it to compare against.
void endParse(uint32_t now) {
  if (rxLen > 0) handleLine();

  if (gotErr || !gotHeader) {                  // failed download: keep showing the last data
    netOk = false;
    if (!gotErr) copyStr(netMsg, "no reply", sizeof(netMsg));
    lastFetchDone = now;
    return;
  }
  netOk = true;
  netMsg[0] = 0;

  // Drop people who are no longer active.
  uint8_t w = 0;
  for (uint8_t i = 0; i < viewCount; i++) {
    if (view[i].seen) {
      if (w != i) view[w] = view[i];
      w++;
    }
  }
  viewCount = w;

  // Keep following the same person if they're still active.
  if (page > 0) {
    bool found = false;
    for (uint8_t i = 0; i < viewCount; i++) {
      if (strcmp(view[i].name, prevName) == 0) { page = i + 1; found = true; break; }
    }
    if (!found) {
      if (page > viewCount) page = viewCount;
      enterPage();
    }
  }

  if (firstLoad) {                             // nothing to flag on the very first load
    for (uint8_t i = 0; i < viewCount; i++) { view[i].mask = 0; view[i].shown = 0; view[i].unseen = false; }
    ovMask = ovShown = 0;
    ovUnseen = false;
    firstLoad = false;
  } else {
    uint8_t om = diffAgg(oldAgg, aggregate());
    if (om && page != 0) {
      ovMask |= om;
      if (om & O_STRUCTURAL) ovUnseen = true;
    }
  }
  updateAlarms(now);
  lastFetchDone = now;
}

// ---------- Buzzer alarms ----------
// A person "needs the buzzer" when they have ALARM_STREAK wrong reps in a row or
// the database says they need attention. Once silenced with the middle button it
// stays quiet for them until the problem clears and happens again.
// Edge cases:
//   * Silenced alarm, person still doing it wrong: stays quiet (acked) instead
//     of starting again on the next download.
//   * Person fixes it (correct rep, attention cleared): acked is reset, so a
//     NEW problem later sounds the buzzer again.
//   * Person leaves: they are removed from the list in endParse(), so their
//     alarm disappears with them and the buzzer can't get stuck on.
//   * The name pop-up only appears when an alarm STARTS, not every download.
void updateAlarms(uint32_t now) {
  for (uint8_t i = 0; i < viewCount; i++) {
    User& u = view[i];
    bool problem = (u.streak >= ALARM_STREAK) || u.needs;
    if (!problem) u.acked = false;             // problem fixed: re-arm for next time
    bool was = u.alarm;
    u.alarm = problem && !u.acked;
    if (u.alarm && !was) {                     // just started: say who it is
      char t[14], nm[9];
      copyStr(nm, u.name, sizeof(nm));
      snprintf(t, sizeof(t), "! %s", nm);
      showToast(now, t);
    }
  }
}

// True while at least one person's alarm is going.
bool anyAlarm() {
  for (uint8_t i = 0; i < viewCount; i++) if (view[i].alarm) return true;
  return false;
}

// Middle button: silence every alarm that is going right now.
void silenceAlarms() {
  for (uint8_t i = 0; i < viewCount; i++) {
    if (view[i].alarm) { view[i].acked = true; view[i].alarm = false; }
  }
}

// Turns the buzzer on (HIGH) or off (LOW). Only touches the pin when that changes.
bool buzzerIsOn = false;
// Edge case: called many times per second; writing only on a change keeps the
// pin from being toggled needlessly.
void setBuzzer(bool on) {
  if (on == buzzerIsOn) return;
  buzzerIsOn = on;
  digitalWrite(PIN_BUZZER, on ? HIGH : LOW);
}

// Plays "beep beep beep ... pause" while an alarm is going, without blocking loop().
uint32_t beepStart = 0;
bool     beeping = false;
// Edge cases: the beep pattern restarts from the first beep each time a new
// alarm begins, and the buzzer is forced off the moment no alarm is left, so
// it can never be left sounding between beeps.
void updateBuzzer(uint32_t now) {
  if (!anyAlarm()) { beeping = false; setBuzzer(false); return; }
  if (!beeping) { beeping = true; beepStart = now; }
  uint32_t t = (now - beepStart) % BEEP_ROUND_MS;
  uint32_t slot = BEEP_ON_MS + BEEP_GAP_MS;
  bool on = (t < slot * BEEPS_PER_ROUND) && ((t % slot) < BEEP_ON_MS);
  setBuzzer(on);
}

// ---------- Text cleanup (same rules as fetch_live.py) ----------
// UTF-8 characters that get swapped for plain ASCII. Any other non-ASCII
// character becomes '?', like Python's encode("ascii", "replace").
struct Translit { const char* from; const char* to; };
const Translit TRANSLIT[] = {
  { "\xC2\xB0",     ""   },   // degree sign
  { "\xE2\x89\xA4", "<=" },   // less-than-or-equal
  { "\xE2\x89\xA5", ">=" },   // greater-than-or-equal
  { "\xC3\x97",     "x"  },   // multiplication sign
  { "\xC2\xB7",     "/"  },   // middle dot
  { "\xE2\x80\xA2", "/"  },   // bullet
  { "\xE2\x80\x93", "-"  },   // en dash
  { "\xE2\x80\x94", "-"  },   // em dash
  { "\xE2\x80\x99", "'"  },   // curly apostrophe
};

// Plain ASCII, no '|' or newlines, at most `limit` characters (0 = no limit).
// Edge cases:
//   * Accents, emoji, symbols: multi-byte UTF-8 characters are swapped for
//     ASCII or replaced by ONE '?' each (the screen font is ASCII only).
//   * A broken or cut-off UTF-8 character at the end of the text: the loop
//     stops at the end of the string instead of reading past it.
//   * '|' would break the line format, so it becomes '/'; newlines become
//     spaces so one value can't turn into two lines.
//   * The output never exceeds `limit` or the buffer size, whichever is smaller.
void cleanText(const char* in, char* out, size_t outSize, size_t limit) {
  size_t maxLen = outSize - 1;
  if (limit && limit < maxLen) maxLen = limit;
  size_t n = 0;
  const uint8_t* p = (const uint8_t*)in;
  while (*p && n < maxLen) {
    uint8_t c = *p;
    if (c < 0x80) {
      if (c == '|') out[n++] = '/';
      else if (c == '\n' || c == '\r') out[n++] = ' ';
      else out[n++] = (char)c;
      p++;
      continue;
    }
    size_t len = (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 : (c >= 0xC0) ? 2 : 1;
    bool swapped = false;
    for (const Translit& t : TRANSLIT) {
      if (strlen(t.from) == len && strncmp((const char*)p, t.from, len) == 0) {
        for (const char* q = t.to; *q && n < maxLen; q++) out[n++] = *q;
        swapped = true;
        break;
      }
    }
    if (!swapped) out[n++] = '?';
    for (size_t k = 0; k < len && *p; k++) p++;
  }
  out[n] = 0;
}

// "squats" -> SQUATS, "jumping_jacks" -> JUMP.JACKS, else upper case, _ -> space, 14 chars.
// Edge cases: an unknown exercise still gets a readable label instead of being
// dropped; a very long name is cut to 14 characters; an empty name stays empty.
void exerciseLabel(const char* raw, char* out, size_t outSize) {
  if (strcmp(raw, "squats") == 0)        { copyStr(out, "SQUATS", outSize); return; }
  if (strcmp(raw, "jumping_jacks") == 0) { copyStr(out, "JUMP.JACKS", outSize); return; }
  char tmp[64];
  size_t i = 0;
  for (; raw[i] && i < sizeof(tmp) - 1; i++) {
    char c = raw[i];
    if (c == '_') c = ' ';
    tmp[i] = (char)toupper((unsigned char)c);
  }
  tmp[i] = 0;
  cleanText(tmp, out, outSize, 14);
}

// ---------- Getting the data ----------
#if USE_WIFI

// Firebase value -> text (strings as-is, numbers printed, missing = empty).
// Edge case: the database might store a field as text, a number, true/false or
// not at all. Every case gives usable text; anything else becomes empty.
void variantText(JsonVariantConst v, char* buf, size_t size) {
  if (v.is<const char*>())     copyStr(buf, v.as<const char*>(), size);
  else if (v.is<bool>())       copyStr(buf, v.as<bool>() ? "True" : "False", size);
  else if (v.is<long long>())  snprintf(buf, size, "%lld", v.as<long long>());
  else if (v.is<double>())     snprintf(buf, size, "%g", v.as<double>());
  else                         buf[0] = 0;
}

// Number fields may arrive as numbers or as text. Rounded to a whole number; bad = 0.
// Edge cases: "12" (text) and 12 (number) both work; 12.6 rounds to 13; text
// that isn't a number, NaN, infinity or a missing field all become 0.
long numVal(JsonVariantConst v) {
  double d;
  if (v.is<const char*>()) {
    const char* s = v.as<const char*>();
    char* end;
    d = strtod(s, &end);
    if (end == s) return 0;
  } else if (v.is<bool>()) {
    d = v.as<bool>() ? 1 : 0;
  } else if (v.is<double>()) {
    d = v.as<double>();
  } else {
    return 0;
  }
  if (isnan(d) || isinf(d)) return 0;
  return lround(d);
}

// Same idea as Python's "if value:".
// Edge case: needs_attention might be true, 1, "yes" or missing; all are
// handled the same way Python's `if value:` would handle them.
bool truthy(JsonVariantConst v) {
  if (v.isNull())                return false;
  if (v.is<bool>())              return v.as<bool>();
  if (v.is<const char*>())       return v.as<const char*>()[0] != 0;
  if (v.is<double>())            return v.as<double>() != 0;
  if (v.is<JsonObjectConst>())   return v.as<JsonObjectConst>().size() > 0;
  if (v.is<JsonArrayConst>())    return v.as<JsonArrayConst>().size() > 0;
  return false;
}

// "INCORRECT" -> 'I', "CORRECT" -> 'C', anything else -> none.
// Edge case: lower case ("incorrect"), missing, or a non-text value -> handled;
// anything that isn't clearly correct/incorrect counts as "no rep yet".
const char* repCode(JsonVariantConst v) {
  if (!v.is<const char*>()) return "";
  char c = (char)toupper((unsigned char)v.as<const char*>()[0]);
  return c == 'I' ? "I" : (c == 'C' ? "C" : "");
}

// Alphabetical comparison for qsort().
int cmpNames(const void* a, const void* b) {
  return strcmp(*(const char* const*)a, *(const char* const*)b);
}

// Turns the /live JSON into the same lines fetch_live.py printed and feeds them in.
// Edge cases:
//   * Not valid JSON (cut-off reply, HTML error page) -> "bad reply".
//   * Firebase error object, e.g. {"error":"Permission denied"} -> shown as
//     the error, not mistaken for a person called "error".
//   * /live is empty or null (nobody exercising) -> "OK|0", shows Waiting...
//   * An entry that isn't an object, or has no / a different status -> skipped.
//   * More than MAX_SORT active people -> all are counted, only the first
//     MAX_SORT are sorted (the screen only shows MAX_USERS anyway).
//   * Names are sorted so the page order doesn't jump around between downloads.
void processPayload(const String& body, uint32_t now) {
  beginParse();

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, body);
  if (err) {
    feedLine("ERR|bad reply");
    endParse(now);
    return;
  }

  JsonVariantConst root = doc.as<JsonVariantConst>();
  char line[160];

  // Firebase answers {"error": "..."} when something is wrong (e.g. rules).
  if (root.is<JsonObjectConst>()) {
    JsonObjectConst obj = root.as<JsonObjectConst>();
    JsonVariantConst e = obj["error"];
    if (obj.size() == 1 && !e.isNull() && !e.is<JsonObjectConst>()) {
      char raw[64], msg[64];
      variantText(e, raw, sizeof(raw));
      cleanText(raw, msg, sizeof(msg), 0);
      snprintf(line, sizeof(line), "ERR|%s", msg);
      feedLine(line);
      endParse(now);
      return;
    }
  }

  // Active people, sorted by name.
  const uint8_t MAX_SORT = 64;
  const char* names[MAX_SORT];
  uint8_t nNames = 0;
  int total = 0;
  if (root.is<JsonObjectConst>()) {
    for (JsonPairConst kv : root.as<JsonObjectConst>()) {
      JsonVariantConst rec = kv.value();
      if (!rec.is<JsonObjectConst>()) continue;
      JsonVariantConst st = rec["status"];
      if (!st.is<const char*>() || strcmp(st.as<const char*>(), "active") != 0) continue;
      total++;
      if (nNames < MAX_SORT) names[nNames++] = kv.key().c_str();   // never writes past the names[] array
    }
  }
  qsort(names, nNames, sizeof(names[0]), cmpNames);

  snprintf(line, sizeof(line), "OK|%d", total);
  feedLine(line);

  JsonObjectConst people = root.as<JsonObjectConst>();
  for (uint8_t i = 0; i < nNames; i++) {
    JsonObjectConst rec = people[names[i]].as<JsonObjectConst>();
    char raw[96], nm[12], ex[16], issue[26], reason[26];

    cleanText(names[i], nm, sizeof(nm), 10);
    variantText(rec["exercise"], raw, sizeof(raw));
    exerciseLabel(raw, ex, sizeof(ex));
    variantText(rec["last_issue"], raw, sizeof(raw));
    cleanText(raw, issue, sizeof(issue), 24);
    variantText(rec["attention_reason"], raw, sizeof(raw));
    cleanText(raw, reason, sizeof(reason), 24);

    snprintf(line, sizeof(line), "%s|%s|%ld|%ld|%ld|%s|%d|%s|%s",
             nm, ex,
             numVal(rec["correct"]), numVal(rec["incorrect"]), numVal(rec["percent_correct"]),
             repCode(rec["last_rep"]),
             truthy(rec["needs_attention"]) ? 1 : 0,
             issue, reason);
    feedLine(line);
  }
  endParse(now);
}

// Records a failed download (no Wi-Fi, no connection, ...) as an ERR line.
void processError(const char* msg, uint32_t now) {
  char line[24];
  snprintf(line, sizeof(line), "ERR|%s", msg);
  beginParse();
  feedLine(line);
  endParse(now);
}

// The download runs in its own task (on the Wi-Fi core) so the screen,
// buttons and pot keep working while it waits on the network, just like
// runAsynchronously() did on the Yun.
enum : uint8_t { FS_IDLE, FS_REQUESTED, FS_RUNNING, FS_DONE };
std::atomic<uint8_t> fetchState(FS_IDLE);
String   fetchBody;                        // written by the task, read by loop() once FS_DONE
char     fetchErr[16] = "";
bool     fetchOk = false;
uint32_t fetchStarted = 0;
bool     timeoutShown = false;

// Background task: waits until loop() asks for a download, then does the
// HTTPS GET to Firebase and hands the reply (or an error) back to loop().
// Edge cases:
//   * Wi-Fi dropped -> reports "no wifi" right away instead of waiting on a
//     connection that can't work (the ESP32 reconnects by itself).
//   * Server unreachable -> HTTP_TIMEOUT_MS stops it hanging forever.
//   * Non-200 replies (401, 404...) are still read, because Firebase puts the
//     reason in the body; only "no answer at all" (code <= 0) is an error.
//   * Two cores share fetchBody: fetchState is atomic and each side only
//     touches fetchBody during its own state, so they never use it at once.
void fetchTask(void*) {
  WiFiClientSecure client;
  client.setInsecure();                    // don't check Firebase's certificate (keeps setup simple)
  HTTPClient http;
  http.setReuse(true);

  String url = String(DB_URL) + "/live.json";
  if (AUTH[0]) url += String("?auth=") + AUTH;

  for (;;) {
    if (fetchState.load() != FS_REQUESTED) { vTaskDelay(pdMS_TO_TICKS(20)); continue; }
    fetchState.store(FS_RUNNING);

    fetchOk = false;
    fetchBody = "";
    fetchErr[0] = 0;

    if (WiFi.status() != WL_CONNECTED) {
      copyStr(fetchErr, "no wifi", sizeof(fetchErr));
    } else {
      http.setConnectTimeout(HTTP_TIMEOUT_MS);
      http.setTimeout(HTTP_TIMEOUT_MS);
      if (!http.begin(client, url)) {
        copyStr(fetchErr, "bad url", sizeof(fetchErr));
      } else {
        int code = http.GET();
        if (code > 0) {                    // any HTTP answer: Firebase errors come back as JSON
          fetchBody = http.getString();
          fetchOk = true;
        } else {
          copyStr(fetchErr, "no conn", sizeof(fetchErr));
        }
        http.end();
      }
    }
    fetchState.store(FS_DONE);
  }
}

// Asks the background task to start a download.
void startFetch(uint32_t now) {
  fetchStarted = now;
  timeoutShown = false;
  fetchState.store(FS_REQUESTED);
}

// Called every loop(): handles a finished download, flags a slow one as a
// timeout, and starts a new download every AUTO_REFRESH_MS (unless on HOLD).
// Edge cases: a download that takes too long marks OFFLINE once (not every
// loop), and a new download is never started while one is still running.
void serviceFetch(uint32_t now) {
  uint8_t s = fetchState.load();
  if (s == FS_DONE) {
    if (fetchOk) processPayload(fetchBody, now);
    else         processError(fetchErr, now);
    fetchBody = "";
    fetchState.store(FS_IDLE);
  } else if (s == FS_REQUESTED || s == FS_RUNNING) {
    if (!timeoutShown && now - fetchStarted > FETCH_TIMEOUT_MS) {
      netOk = false;
      copyStr(netMsg, "timeout", sizeof(netMsg));
      timeoutShown = true;
    }
  } else if (!holdMode && now - lastFetchDone >= AUTO_REFRESH_MS) {
    startFetch(now);
  }
}

// Middle button tap: download now (ignored if one is already running).
// Edge case: pressing refresh repeatedly can't stack up downloads.
void requestRefresh(uint32_t now) {
  if (fetchState.load() == FS_IDLE) startFetch(now);
}

